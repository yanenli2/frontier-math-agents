[{"sha":"68b30e537da83f057bd4f15dae11632af0a198eb","node_id":"C_kwDOFcwZ1doAKDY4YjMwZTUzN2RhODNmMDU3YmQ0ZjE1ZGFlMTE2MzJhZjBhMTk4ZWI","commit":{"author":{"name":"Jovan Gerbscheid","email":"56355248+JovanGerb@users.noreply.github.com","date":"2026-06-25T19:06:39Z"},"committer":{"name":"Jovan Gerbscheid","email":"56355248+JovanGerb@users.noreply.github.com","date":"2026-06-25T19:06:39Z"},"message":"feat: `NSMul`/`NPow` type class (#38036)\n\nThis PR is adds `NSMul`, `NPow`, `ZSMul` and `ZPow` classes for the `nsmul`, `npow`, `zsmul`, `zpow` data fields.\r\n\r\nThis has a few advantages:\r\n\r\n- If you first declare a `SMul` instance, then you don't need to manually write `nsmul := (· • ·)` and `zsmul := (· • ·)` . For `Pow`, the extra benefit is that inferring the instance is preferred over the default field `npowRecAuto`. So this helps avoid accidental diamonds.\r\n- If you first declare a `SMul` instance on a type synonym, then `inferInstanceAs` will infer the `nsmul` field from the `SMul` instance. This makes it easier to avoid diamonds on type synonyms like `Matrix` and `MonoidAlgebra`.\r\n- The not-yet-merged instance diamond linter will be able to detect cases where the `NSMul` and `SMul` classes do not agree.\r\n\r\nIn the process of making this PR, I have identified two existing `NPow` diamonds:\r\n- In `Mathlib.Algebra.Order.Positive.Field`, there were two conflicting `NPow` instances.\r\n- For `Fin`, there are two conflicting `NPow` instances. I have overwritten the one in core lean with the one from mathlib that is more computationally efficient.\r\n\r\nTODO: the same for `QSMul` and `NNQSMul`.","tree":{"sha":"4839152475d9ef60d0164d72de95ee62be1925ff","url":"https://api.github.com/repos/leanprover-community/mathlib4/git/trees/4839152475d9ef60d0164d72de95ee62be1925ff"},"url":"https://api.github.com/repos/leanprover-community/mathlib4/git/commits/68b30e537da83f057bd4f15dae11632af0a198eb","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/leanprover-community/mathlib4/commits/68b30e537da83f057bd4f15dae11632af0a198eb","html_url":"https://github.com/leanprover-community/mathlib4/commit/68b30e537da83f057bd4f15dae11632af0a198eb","comments_url":"https://api.github.com/repos/leanprover-community/mathlib4/commits/68b30e537da83f057bd4f15dae11632af0a198eb/comments","author":{"login":"JovanGerb","id":56355248,"node_id":"MDQ6VXNlcjU2MzU1MjQ4","avatar_url":"https://avatars.githubusercontent.com/u/56355248?v=4","gravatar_id":"","url":"https://api.github.com/users/JovanGerb","html_url":"https://github.com/JovanGerb","followers_url":"https://api.github.com/users/JovanGerb/followers","following_url":"https://api.github.com/users/JovanGerb/following{/other_user}","gists_url":"https://api.github.com/users/JovanGerb/gists{/gist_id}","starred_url":"https://api.github.com/users/JovanGerb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JovanGerb/subscriptions","organizations_url":"https://api.github.com/users/JovanGerb/orgs","repos_url":"https://api.github.com/users/JovanGerb/repos","events_url":"https://api.github.com/users/JovanGerb/events{/privacy}","received_events_url":"https://api.github.com/users/JovanGerb/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"JovanGerb","id":56355248,"node_id":"MDQ6VXNlcjU2MzU1MjQ4","avatar_url":"https://avatars.githubusercontent.com/u/56355248?v=4","gravatar_id":"","url":"https://api.github.com/users/JovanGerb","html_url":"https://github.com/JovanGerb","followers_url":"https://api.github.com/users/JovanGerb/followers","following_url":"https://api.github.com/users/JovanGerb/following{/other_user}","gists_url":"https://api.github.com/users/JovanGerb/gists{/gist_id}","starred_url":"https://api.github.com/users/JovanGerb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JovanGerb/subscriptions","organizations_url":"https://api.github.com/users/JovanGerb/orgs","repos_url":"https://api.github.com/users/JovanGerb/repos","events_url":"https://api.github.com/users/JovanGerb/events{/privacy}","received_events_url":"https://api.github.com/users/JovanGerb/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"ac06f381f4f7d5f7aa4617251e1c9f346dbad20a","url":"https://api.github.com/repos/leanprover-community/mathlib4/commits/ac06f381f4f7d5f7aa4617251e1c9f346dbad20a","html_url":"https://github.com/leanprover-community/mathlib4/commit/ac06f381f4f7d5f7aa4617251e1c9f346dbad20a"}]}]