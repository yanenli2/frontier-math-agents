[{"sha":"7f5fac9d9f78067d1aa95600d706ac86b4a1a154","node_id":"C_kwDOB7kabNoAKDdmNWZhYzlkOWY3ODA2N2QxYWE5NTYwMGQ3MDZhYzg2YjRhMWExNTQ","commit":{"author":{"name":"Sebastian Ullrich","email":"sebasti@nullri.ch","date":"2026-04-27T10:33:58Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-04-27T10:33:58Z"},"message":"feat: add `warn.redundantExpose` for redundant `@[expose]`/`@[no_expose]` attributes (#13359)\n\nThis PR adds a `linter.redundantExpose` option (default `true`) that\nwarns when `@[expose]` or `@[no_expose]` attributes have no effect:\n\n- `@[expose]` on `abbrev` (always exposed) or non-Prop `instance`\n(always exposed)\n- `@[expose]` on a `def` inside an `@[expose] section` (already exposed\nby the section)\n- `@[expose]`/`@[no_expose]` in a non-`module` file (no module system)\n- `@[no_expose]` on a declaration that wouldn't be exposed by default\n\n---------\n\nCo-authored-by: Claude Opus 4.6 (1M context) <noreply@anthropic.com>","tree":{"sha":"b42cd07a1b2c1f25933edae763b890b542a68adc","url":"https://api.github.com/repos/leanprover/lean4/git/trees/b42cd07a1b2c1f25933edae763b890b542a68adc"},"url":"https://api.github.com/repos/leanprover/lean4/git/commits/7f5fac9d9f78067d1aa95600d706ac86b4a1a154","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJp70M+CRC1aQ7uu5UhlAAAU7sQAK5bRFC5oTunjgTE/2Y3EyFS\nppWCNFnjOCg6Ww0PTObCjhOwrzp5r9kZ+7OSFf0qPlDtH3tL6ss2ObB0MhIBy+0K\nqUPu5njv4npEOfu9xb9boRvRzL4reoQn8T0pZN0uuqAYKAkLJI5EzVi5SiThkAM6\nTtTeIPh8oJbLk09hzk3n32TJgygzp4s1mW0dhuJ5gsb9CI1pgxtmfmrNPwIQ1NXz\nZrbXFSXIK8l9qKx8rPh70WA+vosNyI8TI+Tx64bYVdmDmaAB3lq1YExUkyksx87k\nBwY9YGNnbgGeW/HSeNytWzgyls8YNwp/hPiOb5pAVo5h4weCGCaBNfhaLwBkLaKY\naQmdTO08LJtvJyhmhXnF5jIFYsqlCW9PQ0HVGXHx5BDODGK4x0tGqU5GWujMJEcl\nzv52bQQ+W8SUamMC9rgsYQ++BxmNr+YKqFSq2zRVPSuhlt0eIeQ2SMnOSeueYfPU\nH9LvW6dgXihsvn3Abvs0di55O5H37DQN9aH7l4WRJtG/xqp9VEeliZ4wkLlrY75C\nzeEuj1JB3Y24ES/4BfQk372rMq1qxDY7aUSVLgYk4poqhn3l5is07PfRvL/y+s8M\n5jkgnxuyyaQ3o7/6fW1ksymkU+vS92zv77+Ohx1UNgYPdZywKpTG+ise5EgX/87d\n0QydqjsIBDN0ymINXQBC\n=sWr2\n-----END PGP SIGNATURE-----\n","payload":"tree b42cd07a1b2c1f25933edae763b890b542a68adc\nparent 824ccd96627c1205f09f703e4f9e794f9b96b36b\nauthor Sebastian Ullrich <sebasti@nullri.ch> 1777286038 +0200\ncommitter GitHub <noreply@github.com> 1777286038 +0000\n\nfeat: add `warn.redundantExpose` for redundant `@[expose]`/`@[no_expose]` attributes (#13359)\n\nThis PR adds a `linter.redundantExpose` option (default `true`) that\nwarns when `@[expose]` or `@[no_expose]` attributes have no effect:\n\n- `@[expose]` on `abbrev` (always exposed) or non-Prop `instance`\n(always exposed)\n- `@[expose]` on a `def` inside an `@[expose] section` (already exposed\nby the section)\n- `@[expose]`/`@[no_expose]` in a non-`module` file (no module system)\n- `@[no_expose]` on a declaration that wouldn't be exposed by default\n\n---------\n\nCo-authored-by: Claude Opus 4.6 (1M context) <noreply@anthropic.com>","verified_at":"2026-04-27T11:06:39Z"}},"url":"https://api.github.com/repos/leanprover/lean4/commits/7f5fac9d9f78067d1aa95600d706ac86b4a1a154","html_url":"https://github.com/leanprover/lean4/commit/7f5fac9d9f78067d1aa95600d706ac86b4a1a154","comments_url":"https://api.github.com/repos/leanprover/lean4/commits/7f5fac9d9f78067d1aa95600d706ac86b4a1a154/comments","author":{"login":"Kha","id":109126,"node_id":"MDQ6VXNlcjEwOTEyNg==","avatar_url":"https://avatars.githubusercontent.com/u/109126?v=4","gravatar_id":"","url":"https://api.github.com/users/Kha","html_url":"https://github.com/Kha","followers_url":"https://api.github.com/users/Kha/followers","following_url":"https://api.github.com/users/Kha/following{/other_user}","gists_url":"https://api.github.com/users/Kha/gists{/gist_id}","starred_url":"https://api.github.com/users/Kha/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Kha/subscriptions","organizations_url":"https://api.github.com/users/Kha/