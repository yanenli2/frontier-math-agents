def Even.{u_2} : {α : Type u_2} → [Add α] → α → Prop :=
fun {α} [Add α] a => ∃ r, a = r + r
@[irreducible] def Nat.primeFactorsList : ℕ → List ℕ :=
WellFounded.Nat.fix (fun x => x) fun a a_1 =>
  (match (motive := (x : ℕ) → ((y : ℕ) → InvImage (fun x1 x2 => x1 < x2) (fun x => x) y x → List ℕ) → List ℕ) a with
    | 0 => fun x => []
    | 1 => fun x => []
    | k.succ.succ => fun x =>
      let m := (k + 2).minFac;
      m :: x ((k + 2) / m) ⋯)
    a_1
Nat.primeFactorsList_zero : Nat.primeFactorsList 0 = []
Nat.primeFactorsList_one : Nat.primeFactorsList 1 = []
Nat.prime_of_mem_primeFactorsList {n p : ℕ} : p ∈ n.primeFactorsList → Nat.Prime p
Nat.prod_primeFactorsList {n : ℕ} : n ≠ 0 → n.primeFactorsList.prod = n
Nat.primeFactorsList_unique {n : ℕ} {l : List ℕ} (h₁ : l.prod = n) (h₂ : ∀ (p : ℕ), p ∈ l → Nat.Prime p) :
  l.Perm n.primeFactorsList
Nat.Prime.primeFactorsList_pow {p : ℕ} (hp : Nat.Prime p) (n : ℕ) : (p ^ n).primeFactorsList = List.replicate n p
Nat.perm_primeFactorsList_mul {a b : ℕ} (ha : a ≠ 0) (hb : b ≠ 0) :
  (a * b).primeFactorsList.Perm (a.primeFactorsList ++ b.primeFactorsList)
